def random_cycle(offset=0):
    """Create an independent cursor into the fixed number table."""
    return {"index": offset % len(RANDOM_NUMBERS)}


def random_number(cycle):
    """Return the next value in `cycle`, wrapping after the final entry."""
    index = cycle["index"]
    cycle["index"] = (index + 1) % len(RANDOM_NUMBERS)
    return RANDOM_NUMBERS[index]
